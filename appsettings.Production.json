{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://*:8080"
      }
    },
    "ShutdownTimeoutSeconds": 30,
    "Limits": {
      "MaxConcurrentConnections": 100,
      "MaxConcurrentWebSocketConnections": 100
    }
  }
}